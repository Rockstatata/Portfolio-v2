# Public URL, used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (pooled connection string). Without it the site renders src/content/seed.ts
DATABASE_URL=

# Admin dashboard login (/admin)
ADMIN_PASSWORD=
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Vercel Blob read-write token, enables image/PDF uploads from the dashboard
BLOB_READ_WRITE_TOKEN=

# GitHub token for importing repos (public, private and org). `gh auth token` prints one.
GITHUB_TOKEN=
